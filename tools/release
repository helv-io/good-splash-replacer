#!/bin/bash
# The one way to cut a release: bump every place that repeats the version in ONE commit, prove they agree, run the checks, tag.
#   tools/release 0.2.1            commit "Version 0.2.1" and tag v0.2.1 (does not push)
#   tools/release 0.2.1 --dry-run  show what would change, change nothing
set -euo pipefail
v=${1:?usage: tools/release X.Y.Z [--dry-run]}; dry=${2:-}
[[ $v =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "error: version must look like 1.2.3 (no v, no suffix)"; exit 1; }
cd "$(git rev-parse --show-toplevel)"
if [ "$dry" != --dry-run ]; then
  [ "$(git rev-parse --abbrev-ref HEAD)" = master ] || { echo "error: release from master"; exit 1; }
  git diff --quiet && git diff --cached --quiet || { echo "error: commit or stash your changes first"; exit 1; }
  git fetch -q origin master
  [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/master)" ] || { echo "error: master is not the same as origin/master; pull or push first"; exit 1; }
fi
old=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' app/appinfo.json)
[ "$old" != "$v" ] || { echo "error: version is already $v"; exit 1; }
sed -i "s/\"version\": *\"$old\"/\"version\":\"$v\"/" app/appinfo.json
sed -i "s/^  \"version\": \"$old\"/  \"version\": \"$v\"/" package.json
python3 .agent-checks/bin/agent-checks release-version "v$v" || { git checkout -- app/appinfo.json package.json; exit 1; }
if [ "$dry" = --dry-run ]; then git diff --stat; git checkout -- app/appinfo.json package.json; echo "dry run: nothing changed"; exit 0; fi
tools/chk.sh
git commit -q -am "Version $v"
git tag -a "v$v" -m "v$v"
echo "Committed and tagged v$v. Push once CI is green on master: git push origin master v$v"
